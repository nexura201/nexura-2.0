# Variables de entorno para NEXURA
# Copia este archivo a .env y completa los valores

# Aplicación
VITE_APP_URL=http://localhost:3000
VITE_APP_NAME=NEXURA

# NEXURA IA — Google Gemini (SOLO servidor / Vercel Environment Variables)
# Secret server-side: se consume con process.env.GEMINI_API_KEY dentro de api/ai/chat.ts.
# NUNCA ponerle prefijo VITE_, NUNCA subirla al repositorio, NUNCA exponerla al navegador.
GEMINI_API_KEY=

# Modelo de Gemini usado por NEXURA IA (opcional; default del backend: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Base de datos (si usas backend)
# DATABASE_URL=postgresql://user:password@localhost:5432/nexura

# Autenticación (si usas backend)
# AUTH_SECRET=your-secret-key-here

# OWNER de NEXURA (bootstrap opcional del frontend)
# VITE_OWNER_PASSWORD_HASH: hash (NO la contraseña en texto plano) de la
# contraseña inicial del usuario OWNER. Formato: hashed_<20 chars>.
# Se lee en TIEMPO DE BUILD; tras cambiarla hay que REDEPLOYAR en Vercel.
# Si está vacía/ausente, el bundle usa el hash de bootstrap default.
# Solo se usa como semilla para entornos locales o navegador nuevo;
# en producción las credenciales definitivas deben vivir en Supabase Auth
# / PostgreSQL. NUNCA subir a Git un .env con valores reales ni la
# contraseña en claro.
# VITE_OWNER_PASSWORD_HASH=

# Storage (si usas S3/R2)
# STORAGE_ENDPOINT=https://your-bucket.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY=your-access-key
# STORAGE_SECRET_KEY=your-secret-key
# STORAGE_BUCKET=your-bucket-name

# Media Server (si usas MediaMTX)
# RTMP_SERVER_URL=rtmp://localhost:1935/live
# HLS_BASE_URL=http://localhost:8888/live

# Pagos (si usas Stripe)
# PAYMENT_PROVIDER=stripe
# PAYMENT_PUBLIC_KEY=pk_test_xxx
# PAYMENT_SECRET_KEY=sk_test_xxx

# Email (si usas Resend)
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=re_xxx
# EMAIL_FROM=noreply@nexura.live
